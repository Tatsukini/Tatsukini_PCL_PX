<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="FrmModpackUpgrade"
    Title="升级整合包" Icon="/Plain Craft Launcher 2;component/Images/icon.ico"
    Height="620" Width="780" MinHeight="420" MinWidth="620"
    WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display" Background="White">
    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Height="56" Margin="20,0,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LabStep" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource ColorBrushGray3}" Text="第 1 步，共 3 步：选择目标版本" />
            <local:MyButton x:Name="BtnPrev" Grid.Column="1" Text="上一步" Width="96" Height="34" Margin="0,0,10,0" IsEnabled="False" />
            <local:MyButton x:Name="BtnNext" Grid.Column="2" Text="下一步" Width="120" Height="34" Margin="0,0,10,0" />
            <local:MyButton x:Name="BtnClose" Grid.Column="3" Text="取消" Width="76" Height="34" />
        </Grid>
        <ScrollViewer x:Name="PanScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,16">
                <TextBlock x:Name="LabCurrent" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />

                <!-- 第 1 步：选择目标 -->
                <StackPanel x:Name="PanStep1">
                    <TextBlock FontSize="14" FontWeight="Bold" Text="目标 Minecraft 版本" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <local:MyComboBox x:Name="ComboTarget" Width="200" Height="30" Margin="0,0,12,0" ToolTip="要升级到的 Minecraft 版本" />
                        <local:MyTextBox x:Name="TextTarget" Width="220" Height="30" HintText="或直接输入版本号，优先于左侧选择"
                                        ToolTip="手动输入的版本号会覆盖下拉框的选择，例如 1.20.1、26.1" />
                    </StackPanel>
                    <TextBlock FontSize="14" FontWeight="Bold" Text="可用的 Mod 发行类型" Margin="0,18,0,8" />
                    <WrapPanel>
                        <local:MyCheckBox x:Name="CheckRelease" Height="26" Margin="0,0,22,0" Text="正式版" />
                        <local:MyCheckBox x:Name="CheckBeta" Height="26" Margin="0,0,22,0" Text="测试版（Beta）" />
                        <local:MyCheckBox x:Name="CheckAlpha" Height="26" Margin="0,0,22,0" Text="早期测试版（Alpha）" />
                    </WrapPanel>
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource ColorBrushGray3}"
                               Text="只在这些类型中寻找 Mod 的新版本。类型选得越少，被判定为“可能无法下载”的 Mod 就越多。" />
                    <TextBlock FontSize="14" FontWeight="Bold" Text="升级方式" Margin="0,18,0,8" />
                    <local:MyCheckBox x:Name="CheckNewVersion" Height="26" Text="另存为新版本，保留当前版本"
                                      ToolTip="不勾选则就地升级当前版本，当前版本的内核文件会被覆盖" />
                    <local:MyTextBox x:Name="TextNewName" Width="300" Height="30" Margin="0,9,0,0" Visibility="Collapsed"
                                     HintText="新版本文件夹名" MaxLength="100" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource ColorBrushGray3}"
                               Text="升级不会删除存档。存档、材质包等数据的迁移方式将在下一步中逐项确认。" />
                </StackPanel>

                <!-- 第 2 步：兼容性 -->
                <StackPanel x:Name="PanStep2" Visibility="Collapsed">
                    <TextBlock FontSize="14" FontWeight="Bold" Text="新内核" Margin="0,0,0,8" />
                    <TextBlock x:Name="LabKernel" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock FontSize="14" FontWeight="Bold" Text="模组" Margin="0,18,0,8" />
                    <TextBlock x:Name="LabModSummary" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource ColorBrushGray3}" />
                    <StackPanel x:Name="PanMods" />
                    <TextBlock FontSize="14" FontWeight="Bold" Text="数据迁移" Margin="0,18,0,8" />
                    <TextBlock x:Name="LabDataSummary" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource ColorBrushGray3}" />
                    <StackPanel x:Name="PanData" />
                    <local:MyCheckBox x:Name="CheckDisable" Height="26" Margin="0,14,0,0" Text="把无法匹配的模组重命名为 .disabled"
                                      ToolTip="这些模组在新版本下可能崩溃。重命名后可以随时把 .disabled 后缀删掉来恢复。" />
                </StackPanel>

                <!-- 第 3 步：执行 -->
                <StackPanel x:Name="PanStep3" Visibility="Collapsed">
                    <TextBlock FontSize="14" FontWeight="Bold" Text="即将执行" Margin="0,0,0,8" />
                    <TextBlock x:Name="LabSummary" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="LabProgress" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{StaticResource ColorBrushGray3}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

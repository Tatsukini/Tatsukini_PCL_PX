<local:MyPageRight x:Class="PageDownloadSkin"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL"
    mc:Ignorable="d"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="查询皮肤">
                <StackPanel Margin="21,45,21,18">
                    <TextBlock Text="从 LittleSkin 或正版皮肤库获取玩家皮肤与披风。" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="LittleSkin 只支持玩家名；正版支持玩家名与 UID（UUID），可以填写带连字符或不带连字符的 UID。" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="105" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="图片来源" VerticalAlignment="Center" />
                        <local:MyComboBox x:Name="ComboSkinSource" Grid.Column="1" Grid.ColumnSpan="2" Height="32" VerticalAlignment="Center">
                            <local:MyComboBoxItem Content="LittleSkin" Tag="littleskin" IsSelected="True" />
                            <local:MyComboBoxItem Content="正版（Mojang）" Tag="mojang" />
                        </local:MyComboBox>
                        <TextBlock Text="玩家名 / UID" Grid.Row="1" VerticalAlignment="Center" />
                        <local:MyTextBox x:Name="TxtSkinPlayer" Grid.Row="1" Grid.Column="1" Height="32" VerticalAlignment="Center" MaxLength="40"
                                        HintText="请输入 LittleSkin 玩家名" />
                        <local:MyButton x:Name="BtnSkinSearch" Grid.Row="1" Grid.Column="2" Text="查询" Height="32" Margin="10,0,0,0" VerticalAlignment="Center" ColorType="Highlight" />
                        <TextBlock Text="保存目录" Grid.Row="2" VerticalAlignment="Center" />
                        <local:MyTextBox x:Name="TxtSkinFolder" Grid.Row="2" Grid.Column="1" Height="32" VerticalAlignment="Center" IsReadOnly="True" />
                        <local:MyButton x:Name="BtnSkinFolder" Grid.Row="2" Grid.Column="2" Text="选择目录" Height="32" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="LabSkinTip" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="皮肤结果" x:Name="CardSkinResult">
                <StackPanel Margin="21,45,21,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="皮肤纹理" Opacity="0.6" FontSize="12" />
                            <local:MyImage x:Name="ImgSkin" Width="128" Height="128" Margin="0,6,0,0" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" ToolTip="皮肤纹理原图，通常为 64x64 或 64x32" />
                            <TextBlock Text="披风纹理" Margin="0,14,0,0" Opacity="0.6" FontSize="12" />
                            <local:MyImage x:Name="ImgCape" Width="128" Height="64" Margin="0,6,0,0" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" ToolTip="披风纹理原图，通常为 64x32" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <TextBlock x:Name="LabSkinInfo" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <local:MyButton x:Name="BtnSkinDownload" Text="下载皮肤" Height="34" MinWidth="110" IsEnabled="False" />
                                <local:MyButton x:Name="BtnCapeDownload" Text="下载披风" Height="34" MinWidth="110" Margin="10,0,0,0" IsEnabled="False" />
                            </StackPanel>
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.6" FontSize="12"
                                       Text="下载的 PNG 文件可以在【版本设置 → 其他 → 更换皮肤】中使用，也可以直接放到资源包中。" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

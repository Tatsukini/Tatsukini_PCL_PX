<local:MyPageRight x:Class="PageDownloadJava"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL"
    mc:Ignorable="d"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" Title="下载 Java">
                <StackPanel Margin="21,45,21,18">
                    <TextBlock Text="从 Eclipse Temurin（Adoptium）下载 Java 运行时或开发包。" FontSize="14" TextWrapping="Wrap" />
                    <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="下载完成后会自动解压并登记到 Java 列表中，可在【设置 → 启动 → 高级选项】或版本设置中选择使用。" />
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="105" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                            <RowDefinition Height="42" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Java 版本" VerticalAlignment="Center" />
                        <local:MyComboBox x:Name="ComboJavaVersion" Grid.Column="1" Grid.ColumnSpan="2" Height="32" VerticalAlignment="Center" />
                        <TextBlock Text="文件类型" Grid.Row="1" VerticalAlignment="Center" />
                        <local:MyComboBox x:Name="ComboJavaType" Grid.Row="1" Grid.Column="1" Height="32" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <local:MyComboBoxItem Content="JRE（仅运行时，推荐）" Tag="jre" IsSelected="True" />
                            <local:MyComboBoxItem Content="JDK（含开发工具）" Tag="jdk" />
                        </local:MyComboBox>
                        <TextBlock Text="系统架构" Grid.Row="2" VerticalAlignment="Center" />
                        <local:MyComboBox x:Name="ComboJavaArch" Grid.Row="2" Grid.Column="1" Height="32" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <local:MyComboBoxItem Content="x64（64 位，绝大多数电脑）" Tag="x64" IsSelected="True" />
                            <local:MyComboBoxItem Content="aarch64（ARM64）" Tag="aarch64" />
                            <local:MyComboBoxItem Content="x86（32 位，仅 Java 8）" Tag="x86" />
                        </local:MyComboBox>
                        <TextBlock Text="下载源" Grid.Row="3" VerticalAlignment="Center" />
                        <local:MyComboBox x:Name="ComboJavaSource" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="32" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                            <local:MyComboBoxItem Content="自动（遵循设置中的下载源优先级）" Tag="auto" IsSelected="True" />
                            <local:MyComboBoxItem Content="优先镜像（加速下载）" Tag="mirror" />
                            <local:MyComboBoxItem Content="仅官方（GitHub Releases）" Tag="official" />
                        </local:MyComboBox>
                        <TextBlock Text="保存位置" Grid.Row="4" VerticalAlignment="Center" />
                        <local:MyTextBox x:Name="TxtJavaFolder" Grid.Row="4" Grid.Column="1" Height="32" VerticalAlignment="Center" IsReadOnly="True" />
                        <local:MyButton x:Name="BtnJavaFolder" Grid.Row="4" Grid.Column="2" Text="选择目录" Height="32" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="LabJavaInfo" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="正在获取 Java 版本列表……" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <local:MyButton x:Name="BtnJavaDownload" Text="下载并安装该 Java" Height="36" MinWidth="160" ColorType="Highlight" IsEnabled="False" />
                        <local:MyButton x:Name="BtnJavaRefresh" Text="刷新列表" Height="36" MinWidth="110" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="已下载的 Java">
                <StackPanel Margin="21,45,21,18">
                    <TextBlock TextWrapping="Wrap"
                               Text="下列文件夹位于 .minecraft\runtime\ 中，它们会被自动登记到 Java 列表。若要删除某个 Java，直接删除对应文件夹即可。" />
                    <TextBlock x:Name="LabJavaInstalled" Margin="0,10,0,0" TextWrapping="Wrap" />
                    <local:MyButton x:Name="BtnJavaInstalledRefresh" Text="刷新" Height="34" MinWidth="110" HorizontalAlignment="Left" Margin="0,14,0,0" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>

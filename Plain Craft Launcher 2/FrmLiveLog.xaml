<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="FrmLiveLog"
    Title="实时日志" Icon="/Plain Craft Launcher 2;component/Images/icon.ico"
    Height="460" Width="860" MinHeight="220" MinWidth="480"
    WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
    TextOptions.TextFormattingMode="Display" Background="White">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="12,10,12,8" Height="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="13" Text="实时显示启动器日志，关闭本窗口即可停止" />
            <TextBlock Grid.Column="1" x:Name="LabCount" Margin="15,0,15,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource ColorBrushGray3}" />
            <local:MyCheckBox Grid.Column="2" x:Name="CheckAutoScroll" Height="22" Margin="0,0,15,0" Text="自动滚动" />
            <local:MyButton Grid.Column="3" x:Name="BtnCopy" Height="26" Width="56" Margin="0,0,8,0" Text="复制" />
            <local:MyButton Grid.Column="4" x:Name="BtnClear" Height="26" Width="56" Text="清空" />
        </Grid>
        <TextBox x:Name="TxtLog" DockPanel.Dock="Bottom" IsReadOnly="True" AcceptsReturn="True" IsTabStop="False"
                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" TextWrapping="NoWrap" BorderThickness="0"
                 Background="#FF23262B" Foreground="#FFDCDCDC" CaretBrush="#FFDCDCDC" SelectionOpacity="0.4"
                 Padding="8,6,8,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
